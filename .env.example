# STILL V1 — never commit real values to this file.

# Runtime safety. Production refuses fixture mode or a local worker.
APP_MODE=development
USE_PROVIDER_FIXTURES=false
LOCAL_WORKER_ENABLED=false

# Required real-provider credentials (live capability verification later).
GEMINI_API_KEY=
# Server-only key restricted to youtube.googleapis.com for authoritative duration and embed checks.
YOUTUBE_API_KEY=
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
YVP_APP_KEY=

# Optional NVIDIA route. It remains disabled until the spike passes.
ENABLE_NVIDIA_PROVIDER=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Cloud/Firebase runtime.
GOOGLE_CLOUD_PROJECT=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_CLOUD_LOCATION=us-central1
CLOUD_TASKS_QUEUE=still-analysis
WORKER_BASE_URL=
WORKER_INVOKER_SERVICE_ACCOUNT=

# Completions V2 is the documented candidate selected for the live spike.
GLOO_BASE_URL=https://platform.ai.gloo.com
GLOO_ENDPOINT_MODE=completions_v2
GLOO_MAX_CANDIDATES_PER_PROJECT=1
MAX_VIDEO_DURATION_SECONDS=360
MAX_ANALYSIS_PER_USER_PER_DAY=2
MAX_ANALYSIS_GLOBAL_PER_DAY=20
# Optional: evangelical, catholic, or mainline. Omit for the general Christian perspective.
# GLOO_TRADITION=evangelical

# YouVersion uses licensed Bible IDs. Keep this empty until app licensing confirms them.
YVP_BASE_URL=https://api.youversion.com
YVP_ALLOWED_BIBLE_IDS=[]

# Candidate IDs are configuration, not domain constants.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_ESCALATION_MODEL=gemini-3.5-flash
MODEL_POLICY_PATH=config/model-policy.json
PROJECT_VIDEO_ANALYSIS_TOKEN_BUDGET=300000
DAILY_ESCALATION_BUDGET=2
