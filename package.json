{
  "name": "still-v1",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "npm run dev --workspace=@still/web",
    "build": "npm run build --workspace=@still/web",
    "test:web": "npm run test --workspace=@still/web",
    "typecheck": "npm run typecheck --workspace=@still/web",
    "lint": "npm run lint --workspace=@still/web",
    "api:dev": "python -m uvicorn app.main:app --reload --app-dir apps/api",
    "api:test": "python -m pytest apps/api/tests -q"
  },
  "engines": { "node": ">=22" }
}
